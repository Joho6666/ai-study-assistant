{
  "manifest_version": 3,
  "name": "AI 学习辅助",
  "version": "1.0.0",
  "description": "框选练习题，侧边栏给出解析；确认后才填入，从不自动提交。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开学习辅助",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "activeTab", "contextMenus", "sidePanel", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "analyze-selection": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "解析当前选中题目"
    }
  }
}
